{
  "name": "pouchorm",
  "version": "5.0.0",
  "description": "A TypeScript data-modeling library for PouchDB databases and collections.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "pouchdb",
    "orm",
    "odm",
    "typescript",
    "electron",
    "web",
    "react-native"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyobo/pouchorm.git"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "build": "tsc",
    "dev": "tsc -w",
    "audit": "node scripts/audit-dependencies.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml}\" --ignore-path .gitignore",
    "test:docs": "tsc -p website/examples/tsconfig.json --noEmit",
    "test:package": "node scripts/test-package.mjs",
    "verify": "npm run audit && npm run lint && npm run format:check && npm run build && npm run test:docs && npm run test:coverage -- --runInBand && npm run test:package",
    "prepublishOnly": "npm run verify"
  },
  "files": [
    "dist/helpers.*",
    "dist/index.*",
    "dist/PouchCollection.*",
    "dist/PouchORM.*",
    "dist/types.*",
    "docs/**/*",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "MIGRATING_TO_V5.md",
    "SECURITY.md"
  ],
  "author": "Iyobo Eki",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pouchdb-find": "^9.0.0",
    "uuid": "^11.1.1"
  },
  "peerDependencies": {
    "class-validator": ">=0.14.4 <1",
    "pouchdb": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "class-validator": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.14",
    "class-validator": "^0.14.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "pouchdb": "^9.0.0",
    "pouchdb-adapter-memory": "^9.0.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
